# API Keys Configuration File
# Copy this file to 'apikeys.env' and add your actual API keys

# NCBI Configuration (Required for NCBI database)
NCBI_EMAIL=your-email@university.edu
NCBI_API_KEY=your-ncbi-api-key-here

# IUCN Configuration (Required for IUCN database)
IUCN_API_KEY=your-iucn-api-token-here

# Instructions:
# 1. NCBI: Register at https://account.ncbi.nlm.nih.gov/signup/
# 2. IUCN: Request token at https://apiv3.iucnredlist.org/api/v3/token
# Note: Other databases (GBIF, WoRMS, BOLD, Eschmeyer) do not require API keys
