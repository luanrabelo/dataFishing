# dataFishing API Keys Configuration
# Copy this file to 'apikeys.env' and add your API keys

# NCBI Configuration (Required for NCBI database access)
# Register at: https://account.ncbi.nlm.nih.gov/signup/
NCBI_EMAIL=your-email@university.edu
# Optional: Get API key at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=your-ncbi-api-key-here

# IUCN Red List Configuration (Required for IUCN database access)
# Request token at: https://apiv3.iucnredlist.org/api/v3/token
IUCN_API_KEY=your-iucn-api-token-here

# Note: Other databases (GBIF, WoRMS, BOLD, Eschmeyer) do not require API keys
